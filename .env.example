# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/thrift_shop?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
# The app refuses to start a session (login) or verify one (every protected
# page/action) while this is missing or still the literal placeholder value
# below — see lib/auth/secret.ts.
AUTH_SECRET="replace-with-a-long-random-string"

# Cookie name for the session token (change only if you have a reason to).
AUTH_COOKIE_NAME="thrift_session"

# Base URL of the app, used for building absolute links in notifications.
APP_URL="http://localhost:3000"

# Bearer token an external cron trigger must present to call the auction
# closing endpoint (POST /api/cron/close-auctions). Prevents random callers
# from triggering finalization. Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"
